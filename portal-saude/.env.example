# ===== Obrigatório em produção =====
# Domínio do portal (o DNS deve apontar para o servidor). Ex.: saude.suaempresa.com.br
DOMINIO=
# Chave da API da Anthropic para validar os comprovantes automaticamente.
# Sem ela, os comprovantes ficam "em análise" para revisão manual do RH.
ANTHROPIC_API_KEY=

# ===== Opcional =====
# Modelo usado na validação (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# E-mail dos lembretes (SMTP). Ex.: smtps://usuario:senha@smtp.suaempresa.com.br:465
SMTP_URL=
EMAIL_REMETENTE=Viva Bem <nao-responda@suaempresa.com.br>

# WhatsApp dos lembretes, via Twilio (WhatsApp Business). Deixe vazio para desligar.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Recompensas (true/false) e pontos por pausa ativa (1 por dia)
FEATURE_RECOMPENSAS=true
PAUSA_ATIVA_PONTOS=1
# Dias de backup guardados
BACKUP_DIAS=14

# ===== Desenvolvimento local (npm start) =====
# PORT=3000
# DB_PATH=./data/portal.db
# UPLOAD_DIR=./data/uploads
# BACKUP_DIR=./data/backups
