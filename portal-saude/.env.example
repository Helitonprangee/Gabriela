# Porta HTTP
PORT=3000
# Chave da API da Anthropic para a validação automática dos comprovantes.
# Sem ela, os comprovantes ficam "em análise" para revisão manual do RH.
ANTHROPIC_API_KEY=
# Modelo usado na validação (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Caminhos de dados (padrão: ./data)
# DB_PATH=./data/portal.db
# UPLOAD_DIR=./data/uploads
# Fase 2 - troca de pontos por recompensas (ainda sem telas)
FEATURE_RECOMPENSAS=false
