{
  "name": "portal-saude",
  "version": "1.0.0",
  "description": "Portal de saúde e bem-estar para colaboradores de uma rede de supermercados",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/services/backup.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
